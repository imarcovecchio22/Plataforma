generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pendiente
  pagado
  en_preparacion
  enviado
  entregado
  cancelado
}

model Product {
  id               String   @id @default(cuid())
  nombre           String
  // Para la URL de la ficha: /producto/<slug>
  slug             String   @unique
  // Los inactivos no se muestran en la tienda (el admin los sigue viendo)
  activo           Boolean  @default(true)
  // Orden en la tienda, de menor a mayor: el primero activo es el destacado de la home
  orden            Int      @default(0)
  // Unidad de venta de este producto (vacía = la del cliente, config.unidad)
  unidadSingular   String?
  unidadPlural     String?
  unidadGenero     String? // "masculino" | "femenino"
  // Va al lado del precio (ej. "el frasco de 500 g"); vacía = config.textos.aclaracionPrecio
  aclaracionPrecio String?
  descripcion      String
  precio           Int
  // Promos por cantidad: [{ desde: 5, precio: 6000 }, ...] (precio por frasco desde esa cantidad)
  escalones        Json     @default("[]")
  stock            Int      @default(0)
  imagenUrl        String?
  // Categoría (solo si el cliente usa categorías: config.catalogo.categorias)
  categoriaId      Int?
  categoria        Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  // Opciones que elige el comprador (config.catalogo.opciones): [{ nombre: "Color", valores: ["Rojo", "Negro"] }]
  opciones         Json     @default("[]")
  // A pedido (config.catalogo.aPedido): sin límite de stock (no se descuenta al pagar) y con demora
  aPedido          Boolean  @default(false)
  // Lo que se muestra de la demora (ej. "Se imprime en 3 a 5 días hábiles"); vacía = un texto general
  demora           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items   OrderItem[]
  postsIG PostIG[]

  @@index([activo, orden])
}

// Categorías del catálogo (config.catalogo.categorias), se editan en /admin/categorias
model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String
  // Para el filtro de /productos?categoria=<slug>
  slug      String    @unique
  orden     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  productos Product[]
}

model Order {
  id        String   @id @default(cuid())
  numero    Int      @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Datos del cliente
  nombre   String
  apellido String
  email    String
  telefono String

  // Dirección de entrega
  calle        String
  numero_dir   String
  pisoDepto    String?
  localidad    String
  provincia    String
  codigoPostal String

  // Detalle del pedido: sus ítems, el envío y el total cobrado (ítems + envío)
  items       OrderItem[]
  // Zona elegida (su nombre queda copiado en provincia) y lo que se cobró de envío (0 = a coordinar)
  zonaEnvioId Int?
  zonaEnvio   ZonaEnvio?  @relation(fields: [zonaEnvioId], references: [id], onDelete: SetNull)
  costoEnvio  Int         @default(0)
  total       Int

  estado         OrderStatus @default(pendiente)
  mpPaymentId    String?
  mpPreferenceId String?

  // ?origen= con el que llegó a /producto (ej: "instagram" desde ManyChat)
  origen String?

  @@index([estado])
  @@index([mpPreferenceId])
}

// Zonas de envío que el comprador elige en el checkout (se editan en /admin/envios).
model ZonaEnvio {
  id             Int      @id @default(autoincrement())
  nombre         String
  // Costo fijo que se suma al total (y a Mercado Pago); vacío = a coordinar después de la compra
  costo          Int?
  // Debajo del selector de zona (ej. "Por ahora enviamos solo dentro de CABA.")
  aclaracion     String   @default("")
  // En el resumen de la compra (vacío = un texto según el costo)
  detalleResumen String   @default("")
  activa         Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  pedidos        Order[]

  @@index([activa, orden])
}

// Un producto dentro de un pedido. Guarda una copia de lo que se vendió (nombre y precios), así
// el pedido no cambia si después se edita el producto.
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  nombre         String
  precioUnitario Int // con la promo por cantidad ya aplicada
  cantidad       Int
  // Lo que eligió de las opciones del producto: [{ nombre: "Color", valor: "Rojo" }] (el nombre ya lo incluye)
  opciones       Json     @default("[]")
  subtotal       Int

  @@index([orderId])
  @@index([productId])
}

enum CanalRespuesta {
  instagram
  email
}

enum ConsultaEstado {
  nueva
  respondida
  archivada
}

model Consulta {
  id        Int            @id @default(autoincrement())
  nombre    String
  canal     CanalRespuesta
  instagram String? // siempre con @ adelante
  email     String?
  mensaje   String
  origen    String? // ?origen= de la URL (ej: "instagram" desde ManyChat)
  estado    ConsultaEstado @default(nueva)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([estado, createdAt])
}

// Preguntas frecuentes de /consultas (se editan en /admin/preguntas).
// La respuesta admite $PRODUCTO, $PRECIO, $PROMOS, [[ solo si hay promos ]] y [links](#ancla).
model PreguntaFrecuente {
  id        Int      @id @default(autoincrement())
  pregunta  String
  respuesta String
  orden     Int      @default(0) // se muestran de menor a mayor
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa, orden])
}

enum LogNivel {
  info
  warn
  error
}

// Registro de eventos de la web (se ve en /admin/logs)
model EventLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  nivel     LogNivel @default(info)
  tipo      String // pedido, pago, consulta, telegram, admin, imagen
  mensaje   String
  detalle   Json?

  @@index([createdAt])
  @@index([nivel, createdAt])
  @@index([tipo, createdAt])
}

enum TipoPostIG {
  presentacion
  producto
  dato
  promo // las promos por cantidad de "Precio y stock"
}

enum EstadoPostIG {
  pendiente
  generando
  esperando_aprobacion
  publicando
  publicado
  descartado
  error
}

enum DestinoPostIG {
  feed
  story
  both
}

// Cronograma de Instagram (reemplaza la Google Sheet "Cronograma" y los escenarios de Make)
model PostIG {
  id     Int        @id @default(autoincrement())
  fecha  DateTime   @db.Date // día desde el que se puede generar
  tipo   TipoPostIG
  estilo String // uno de config.estilosInstagram del cliente (se valida en la app)
  tema   String

  // Producto del catálogo (tipo producto y promo): al generar, nombre, precio, foto y promos salen de
  // él. En un post de promo sin producto se usa el destacado; en uno de producto sin producto, los
  // datos que se cargan a mano abajo.
  productoId String?
  producto   Product? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  // Solo para tipo producto (datos reales que carga el admin; con producto del catálogo, lo que se
  // usó en la última generación)
  nombreProducto String?
  categoria      String?
  precio         String?
  presentacion   String?
  imagenUrl      String?

  estado   EstadoPostIG @default(pendiente)
  copy     Json? // textos que escribió Gemini (tagline, titulo, etc.)
  caption  String?
  feedUrl  String?
  storyUrl String?

  destino           DestinoPostIG?
  feedMediaId       String?
  storyMediaId      String?
  telegramMessageId Int?
  error             String?

  generadoEn  DateTime?
  publicadoEn DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([estado, fecha])
}

// ── Respuestas automáticas de Instagram (reemplazan a ManyChat) ──

enum CoincidenciaRegla {
  contiene // alguna palabra clave aparece como palabra completa en el mensaje
  exacta // el mensaje entero es una de las palabras clave
}

enum CanalRegla {
  dm
  comentario
  ambos
}

model AutoRespuesta {
  id                         Int               @id @default(autoincrement())
  nombre                     String // interno, para reconocerla en el admin
  palabrasClave              String[]
  coincidencia               CoincidenciaRegla @default(contiene)
  canal                      CanalRegla        @default(ambos)
  respuesta                  String // $PRECIO se reemplaza por el precio actual del producto
  botones                    Json              @default("[]") // [{ titulo, url }] hasta 3
  respuestaPublicaComentario String?
  prioridad                  Int               @default(0) // gana la más alta
  activa                     Boolean           @default(true)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  eventos                    InstagramEvento[]
}

enum TipoEventoIG {
  dm
  comentario
}

enum AccionEventoIG {
  procesando // reservado apenas llega (así un reintento de Meta no responde dos veces)
  respondido
  sin_coincidencia
  ignorado
  error
}

// Cada mensaje o comentario recibido por el webhook de Instagram y qué se hizo con él
model InstagramEvento {
  id               Int            @id @default(autoincrement())
  tipo             TipoEventoIG
  externalId       String         @unique // mid del mensaje o id del comentario
  usuarioIgId      String
  texto            String
  reglaId          Int?
  regla            AutoRespuesta? @relation(fields: [reglaId], references: [id], onDelete: SetNull)
  accion           AccionEventoIG @default(procesando)
  error            String?
  // false = una respuesta que ya no bloquea (se tocó "Reiniciar límite" en el admin)
  cuentaParaLimite Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@index([createdAt])
  @@index([usuarioIgId, reglaId, createdAt])
}

// Token de la API de Instagram (Instagram Login). Una sola fila (id = 1); se renueva sola.
model InstagramToken {
  id          Int       @id @default(1)
  accessToken String
  igUserId    String
  expiresAt   DateTime? // null = todavía no se sabe (token recién cargado desde el entorno)
  envHash     String? // huella del IG_ACCESS_TOKEN del que salió: si cambia en Vercel, se vuelve a tomar
  updatedAt   DateTime  @updatedAt
}

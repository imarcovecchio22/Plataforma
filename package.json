{
  "name": "plataforma",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/preparar-cliente.ts --dev && next dev",
    "build": "prisma generate && tsx scripts/preparar-cliente.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preparar-cliente": "tsx scripts/preparar-cliente.ts",
    "cliente": "node scripts/con-cliente.js",
    "db:migrate": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@prisma/client": "^5.20.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "jose": "^5.9.6",
    "mercadopago": "^3.6.1",
    "next": "^16.3.6",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.4.47",
    "postcss-import": "^15.1.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}

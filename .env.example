# Cliente de este despliegue: carpeta clientes/<CLIENTE> (identidad, tema, plantillas)
CLIENTE="melera"

# Base de datos (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# MercadoPago
MP_ACCESS_TOKEN="TEST-xxxxxxxx"
MP_PUBLIC_KEY="TEST-xxxxxxxx"

# Admin (hardcodeado por ahora)
ADMIN_USER="admin"
ADMIN_PASSWORD="cambiar-esta-password"

# Sesión / JWT
NEXTAUTH_SECRET="generar-un-secreto-largo-y-random"
NEXTAUTH_URL="http://localhost:3000"


# URL pública del sitio (para redirects de MercadoPago)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Bot de Telegram para avisar pedidos pagados y consultas nuevas (opcional; sin esto no se avisa)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# API key de Google Gemini para el chat de atención al cliente (widget flotante) — gratis, sin tarjeta
GEMINI_API_KEY="AIzaSyxxxxxxxx"

# Imágenes IG (/api/generate, renderizadas con Chromium en Vercel): secreto del webhook de Make
# y de la firma de las URLs /api/img (IMAGE_SIGNING_SECRET es opcional; si no está usa el mismo)
GENERATE_WEBHOOK_SECRET="generar-un-secreto-random"
IMAGE_SIGNING_SECRET=""

# Vercel Cron: los crons diarios (/api/cron/*) llegan con "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="generar-un-secreto-random"

# Respuestas automáticas de Instagram (reemplazan a ManyChat) — Instagram API con Instagram Login.
# Paso a paso en docs/instagram-setup.md. IG_APP_SECRET es el "Instagram app secret" (no el de la app de Facebook).
IG_APP_ID=""
IG_APP_SECRET=""
IG_WEBHOOK_VERIFY_TOKEN="generar-un-secreto-random"
# Token de larga duración (60 días) e id de la cuenta; después se renueva solo y se guarda en la base.
IG_ACCESS_TOKEN=""
IG_USER_ID=""
